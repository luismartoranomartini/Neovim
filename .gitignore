# =========================================================
# martini.nvim — .gitignore
# =========================================================

# ---- Estado local do Neovim que não deve ser versionado ----
.netrwhist
*.swp
*.swo
*~

# ---- Logs de LSP / debugger que às vezes acabam no cwd ----
gopls.log
lsp.log
dap.log
.dap_breakpoints

# ---- Artefatos de compilação/debug (Go, C/C++, Rust) ----
*.exe
*.out
__debug_bin*
*.test

# ---- Ambiente NTFS/Windows ----
Thumbs.db
desktop.ini
ehthumbs.db

# ---- macOS ----
.DS_Store

# ---- Editores/ferramentas auxiliares ----
.vscode/
.idea/

# ---- Rascunhos pessoais ----
scratch.lua
TODO.local.md
